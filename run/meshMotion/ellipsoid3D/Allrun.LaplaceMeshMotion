#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

echo Copy the template case into the Laplace deformation case 
(
    cp -r ellipsoid3D ellipsoid3DLaplace
)

echo Deform the mesh with constant/dynamicMesh.Laplace settings and moveDynamicMesh 
(
    cd ellipsoid3DLaplace 

    ./Allclean

    cp constant/dynamicMeshDict.Laplace constant/dynamicMeshDict
    
    ./Allrun
)

